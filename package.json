{
  "name": "dsh-translate",
  "version": "1.13.2",
  "description": "Full-page translation for DeepSeek Harness backed by a local OpenAI-compatible HY-MT translation model: translate the rendered web GUI into your language while preserving code, paths, commands, identifiers, numbers and product names. Display-only; the session log is never touched.",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "translation",
    "i18n",
    "dom",
    "client-plugin",
    "hy-mt",
    "llama.cpp",
    "gguf",
    "local-translation"
  ],
  "license": "Apache-2.0",
  "author": {
    "name": "PerryLink",
    "url": "https://github.com/PerryLink"
  },
  "contributors": [
    {
      "name": "sakemo12",
      "url": "https://github.com/sakemo12"
    }
  ],
  "private": false,
  "type": "module",
  "main": "./index.mjs",
  "exports": {
    ".": {
      "default": "./index.mjs"
    },
    "./typert": {
      "default": "./typert.host.mjs"
    },
    "./client": {
      "default": "./client/index.js"
    },
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "index.mjs",
    "typert.host.mjs",
    "lib",
    "client",
    "locale",
    "icon.svg",
    "cordis.patch.yml",
    "README.md",
    "README.en.md",
    "CHANGELOG.md",
    "SECURITY.md",
    "PRIVACY.md",
    "NOTICE",
    "THIRD_PARTY_NOTICES.md",
    "LICENSE"
  ],
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.5",
    "@deepseek-ai/dsh-typert-protocol": ">=0.2.1-0 <0.3.0",
    "@deepseek-ai/schemastery": "^3.18.5"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.5",
    "@deepseek-ai/dsh-typert-protocol": "0.2.1-rc.2",
    "@deepseek-ai/schemastery": "3.18.5",
    "jsdom": "^31.0.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0",
    "dsh": ">=0.2.1-0 <0.3.0"
  },
  "scripts": {
    "test": "node --test \"test/**/*.test.mjs\"",
    "lint": "node scripts/lint.mjs",
    "check:lockfile": "node scripts/check-lockfile-drift.mjs",
    "verify:self-contained": "node scripts/verify-self-contained.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sakemo12/harness-lingo-translator.git"
  },
  "homepage": "https://github.com/sakemo12/harness-lingo-translator#readme",
  "bugs": {
    "url": "https://github.com/sakemo12/harness-lingo-translator/issues"
  }
}
